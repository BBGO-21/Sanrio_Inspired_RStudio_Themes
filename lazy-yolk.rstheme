/* rs-theme-name: Lazy Yolk */
/* rs-theme-is-dark: FALSE */

/* Palette
   Background        #FFFBEA
   Default text      #3A2A14
   Keywords, section headers, errors (bold)  #A8561A
   Functions         #6E5400
   Strings           #A3352A
   Numbers, TRUE/FALSE/NULL  #2F5A82
   Comments (italic) #8E7E62
   Accent: cursor, matching brackets, selected tab  #E0A800
   Nested parentheses  #3A2A14 / #75603C / #9E8E70
*/

/* ---------- Editor ---------- */
.ace_editor,
.rstudio-themes-flat.ace_editor_theme,
.rstudio-themes-flat .ace_editor_theme {
  background-color: #FFFBEA;
  color: #3A2A14;
}

/* Gutter (line numbers) */
.ace_gutter {
  background-color: #F7F0D2;
  color: #6E6048;
}
.ace_gutter-active-line {
  background-color: #F7E29A;
  color: #3A2A14;
}
.ace_print-margin {
  width: 1px;
  background-color: #E2D29E;
}

/* Cursor, selection, current line */
.ace_cursor {
  color: #E0A800;
}
.ace_marker-layer .ace_selection {
  background-color: #F9D9C6;
}
.ace_marker-layer .ace_active-line {
  background-color: #FFF1BF;
}
.ace_marker-layer .ace_selected-word {
  border: 1px solid #A8561A;
}

/* Matching brackets: underline */
.ace_marker-layer .ace_bracket {
  margin: 0;
  border: none;
  border-bottom: 2px solid #E0A800;
}

/* Syntax */
.ace_identifier {
  color: #3A2A14;
}
.ace_keyword {
  color: #A8561A;
  font-weight: bold;
}
.ace_keyword.ace_operator {
  color: #3A2A14;
  font-weight: normal;
}
.ace_constant.ace_language,
.ace_constant.ace_numeric {
  color: #2F5A82;
}
.ace_string {
  color: #A3352A;
}
.ace_support.ace_function {
  color: #6E5400;
}

/* Comments: quieter */
.ace_comment {
  color: #8E7E62;
  font-style: italic;
}
.ace_comment.ace_keyword {
  color: #6E5400;
  font-style: italic;
}

/* Section headers (# Title ----): bold landmarks */
.ace_comment.ace_sectionhead {
  color: #A8561A;
  font-style: normal;
  font-weight: bold;
}

/* Parentheses by nesting level
   (turn on Rainbow parentheses in Global Options > Code > Display) */
.ace_paren,
.ace_paren_color_0,
.ace_paren_color_3,
.ace_paren_color_6 {
  color: #3A2A14;
}
.ace_paren_color_1,
.ace_paren_color_4 {
  color: #75603C;
}
.ace_paren_color_2,
.ace_paren_color_5 {
  color: #9E8E70;
}

/* R Markdown / Quarto */
.ace_marker-layer .ace_foreign_line {
  background-color: #FFF5D0;
}
.ace_markup.ace_heading {
  color: #A8561A;
  font-weight: bold;
}
.ace_markup.ace_href {
  color: #6E5400;
  text-decoration: underline;
}

/* Console and debugging */
.ace_console_error {
  color: #A8561A;
  font-weight: bold;
}
.ace_marker-layer .ace_active_debug_line {
  background-color: #DFD6B7;
}


/* =====================================================================
   RStudio interface (tabs, panes, toolbars, menus, scrollbars)
   These use RStudio's internal class names, which are not officially
   supported and may change between versions. If an update breaks
   something, delete this section and the editor colors above still work.
   ===================================================================== */

/* Space behind and between panes, and the strip under the main toolbar */
body.rstudio-themes-flat,
.rstudio-themes-flat.rstudio-themes-dark,
.rstudio-themes-flat .rstudio-themes-dark,
.rstudio-themes-flat .rstudio-themes-default,
.rstudio-themes-flat .rstudio-themes-background,
.rstudio-themes-flat [role="banner"] + [role="navigation"] > table > tbody > tr > td,
.rstudio-themes-flat header + [role="navigation"] > table > tbody > tr > td,
.rstudio-themes-flat .gwt-SplitLayoutPanel-HDragger,
.rstudio-themes-flat .gwt-SplitLayoutPanel-VDragger {
  background-color: #ECE0B6 !important;
}

/* Pane frames, including the focus ring around the active pane */
.rstudio-themes-flat .windowframe,
.rstudio-themes-flat .windowframe:focus-within,
.rstudio-themes-flat .windowframe > div,
.rstudio-themes-flat .rstudio-themes-border,
.rstudio-themes-flat :-webkit-any(.windowframe, .rstheme_minimizedWindowObject) > div:last-child {
  border-color: #E2D29E !important;
  outline-color: #E2D29E !important;
  box-shadow: none !important;
}
.rstudio-themes-flat *:focus,
.rstudio-themes-flat *:focus-visible {
  outline-color: #E0A800 !important;
}

/* Tab strip */
.rstudio-themes-flat .gwt-TabLayoutPanelTabs,
.rstudio-themes-flat .rstheme_multiPodUtilityTabArea {
  background-color: #F7F0D2 !important;
}

/* Unselected tabs: quiet */
.rstudio-themes-flat .gwt-TabLayoutPanelTab:not(.gwt-TabLayoutPanelTab-selected) .rstheme_tabLayoutCenter {
  background-color: #F7F0D2 !important;
  border-top: 2px solid transparent !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTab:not(.gwt-TabLayoutPanelTab-selected) .gwt-Label {
  color: #6E6048 !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTab:hover .rstheme_tabLayoutCenter {
  background-color: #F0E6C0 !important;
}

/* Selected tab: matches the editor, with an accent top bar */
.rstudio-themes-flat .gwt-TabLayoutPanelTab.gwt-TabLayoutPanelTab-selected .rstheme_tabLayoutCenter,
.rstudio-themes-flat .windowframe:focus-within .gwt-TabLayoutPanelTab-selected .rstheme_tabLayoutCenter {
  background-color: #FFFBEA !important;
  border-top: 2px solid #E0A800 !important;
  border-left-color: #E2D29E !important;
  border-right-color: #E2D29E !important;
}
.rstudio-themes-flat .gwt-TabLayoutPanelTab-selected .gwt-Label {
  color: #3A2A14 !important;
  font-weight: bold;
}

/* Minimized panes */
.rstudio-themes-flat .rstheme_minimizedWindowObject .rstheme_center {
  background-color: #F7F0D2 !important;
}

/* Toolbars */
.rstudio-themes-flat .rstheme_toolbarWrapper,
.rstudio-themes-flat .rstheme_secondaryToolbar,
.rstudio-themes-flat .dataGridHeader {
  background-color: #F7F0D2 !important;
  border-color: #E2D29E !important;
}
.rstudio-themes-flat .rstheme_toolbarWrapper .gwt-Label,
.rstudio-themes-flat .rstheme_toolbarWrapper a,
.rstudio-themes-flat .rstheme_toolbarWrapper button {
  color: #3A2A14 !important;
}

/* Menus and popups */
.rstudio-themes-flat .popupMiddleCenter,
.rstudio-themes-flat .menuPopupMiddleCenter,
.rstudio-themes-flat .suggestPopupMiddleCenter,
.rstudio-themes-flat .themedPopupPanel,
.rstudio-themes-flat .gwt-PopupPanel .popupContent {
  background-color: #F7F0D2 !important;
  color: #3A2A14 !important;
}
.rstudio-themes-flat .gwt-MenuItem.gwt-MenuItem-selected,
.rstudio-themes-flat .item.item-selected {
  background-color: #F9D9C6 !important;
  color: #3A2A14 !important;
}

/* Scrollbars */
.rstudio-themes-flat {
  scrollbar-color: #C5B688 #F7F0D2;
}
.rstudio-themes-flat ::-webkit-scrollbar-track {
  background-color: #F7F0D2;
}
.rstudio-themes-flat ::-webkit-scrollbar-thumb {
  background-color: #C5B688;
  border-radius: 6px;
}
.rstudio-themes-flat ::-webkit-scrollbar-thumb:hover {
  background-color: #9B8C65;
}


/* Corner doodle in the console (original artwork). Delete this block to remove it.
   Targets the scrolling area that holds RStudio's console output. RStudio does not
   document these IDs, so this is a best guess. */
.rstudio-themes-flat :has(> #rstudio_console_output) {
  background-image: url("data:image/svg+xml;base64,") !important;
  background-repeat: no-repeat !important;
  background-position: right 24px bottom 16px !important;
  background-size: 140px auto !important;
}
